{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to Tippler's Log.","text":""},{"location":"opinions/%E9%9B%B6%E7%A2%8E%E7%9A%84%E8%A7%82%E7%82%B9/","title":"\u96f6\u788e\u7684\u89c2\u70b9","text":"<ul> <li>\u6c89\u4e0b\u5fc3\uff0c\u53bb\u611f\u53d7\u65e0\u804a\u3002</li> <li>\u591a\u770b\u6587\u7ae0\uff0c\u5c11\u770b\u89c6\u9891\u3002</li> <li>\u8fd1\u671f\u83b7\u53d6\u5feb\u4e50\u7684\u9608\u503c\u5927\u5e45\u63d0\u9ad8\uff0c\u9010\u6e10\u5931\u53bb\u5bf9\u6e38\u620f\u7684\u5174\u8da3\uff0c\u5bf9\u5927\u90e8\u5206 B \u7ad9\u89c6\u9891\u90fd\u63d0\u4e0d\u8d77\u5174\u8da3\u3002\u5c31\u7b97\u662f\u6296\u97f3\uff0c\u5728\u5237\u5b8c\u4e86\u76f8\u5bf9\u4f18\u8d28\u7684\u89c6\u9891\u540e\uff0c\u4e5f\u4f1a\u611f\u5230\u4e4f\u5473\u3002\u4e2a\u4eba\u611f\u89c9\u6295\u8d44\u7406\u8d22\u7684\u5185\u5bb9\u5bf9\u6b64\u6709\u4e00\u5b9a\u5f71\u54cd\uff0c\u5c24\u5176\u662f\u65e5\u5185\u770b\u76d8\u3002\u5bf9\u6b64\uff0c\u5f53\u524d\u7684\u60f3\u6cd5\u662f\uff0c\u4ec5\u5728\u5f00\u76d8\u548c\u6536\u76d8\u7684 15 \u5206\u949f\u5de6\u53f3\u770b\u76d8\u548c\u64cd\u4f5c\uff0c\u903c\u81ea\u5df1\u4e0d\u5728\u65e5\u5185\u4ea4\u6613\u65f6\u95f4\u770b\u884c\u60c5\uff0c\u4e13\u6ce8\u5f53\u4e0b\u7684\u751f\u6d3b\u3002\u6295\u8d44\u7b56\u7565\u4e5f\u9700\u4f18\u5316\uff0c\u6216\u8bb8\u62c9\u957f\u65f6\u95f4\u6765\u770b\uff0c\u65e5\u5185\u7684\u4ea4\u6613\u4e0e\u6ce2\u52a8\u5e76\u4e0d\u7b97\u4ec0\u4e48\u3002</li> <li>\u5bf9 AI \u7684\u4f9d\u8d56\u4e25\u91cd\u5f71\u54cd\u4e86\u6211\u72ec\u7acb\u601d\u8003\u89e3\u51b3\u95ee\u9898\u7684\u80fd\u529b\u3002\u9047\u5230\u95ee\u9898\u65f6\uff0c\u6211\u66f4\u503e\u5411\u4e8e\u76f4\u63a5\u4e22\u7ed9 AI \u6216\u8005\u4ec5\u4ec5\u505c\u7559\u5728\u7ed9 AI \u63cf\u8ff0\u95ee\u9898\uff0c\u800c\u975e\u81ea\u5df1\u5c1d\u8bd5\u601d\u8003\u89e3\u51b3\u3002\u6b64\u5916\uff0c\u7531\u4e8e\u5de5\u4f5c\u8fc7\u7a0b\u4e2d\u4f7f\u7528 AI \u9700\u8981\u7b49\u5f85\u5176\u5b8c\u6210\u6307\u4ee4\uff0c\u6574\u5757\u7684\u5de5\u4f5c\u65f6\u95f4\u6839\u636e AI \u7684\u5de5\u4f5c\u5b8c\u6210\u65f6\u95f4\u88ab\u5206\u5272\uff0c\u4e00\u65b9\u9762\u7b49\u5f85\u7684\u65f6\u95f4\u6ca1\u6709\u88ab\u5f88\u597d\u7684\u5229\u7528\uff0c\u56e0\u4e3a\u6211\u4e0d\u77e5\u9053 AI \u4ec0\u4e48\u65f6\u5019\u80fd\u591f\u5b8c\u6210\u6211\u7ed9\u7684\u6307\u4ee4\uff0c\u53e6\u4e00\u65b9\u9762\uff0c\u6211\u7684\u65f6\u95f4\u53d8\u5f97\u96f6\u788e\u5316\uff0c\u6301\u7eed\u4e13\u6ce8\u7684\u80fd\u529b\u4e5f\u5927\u5e45\u4e0b\u964d\u3002</li> </ul>"},{"location":"writings/20260216/","title":"\u8bb0\u4e00\u6b21\u5bb6\u5ead\u805a\u9910","text":"<p>\u9664\u5915\u524d\u4e00\u665a\uff0c\u5bb6\u5ead\u805a\u9910\uff0c\u8205\u8205\u4e00\u5bb6\u3001\u59e8\u7236\u4e00\u5bb6\u4ee5\u53ca\u6211\u4eec\u4e00\u5bb6\u5916\u52a0\u6211\u5916\u516c\u548c\u5976\u5976\uff0c\u5171\u8ba1\u5341\u4e00\u4eba\u3002\u665a\u8f88\u5171\u4e09\u4eba\uff0c\u6211\u662f\u6700\u5c0f\u7684\uff0c\u4e24\u4e2a\u54e5\u54e5\u5206\u522b\u6bd4\u6211\u5927\u516d\u5c81\u548c\u5341\u4e8c\u5c81\u3002\u4e4b\u6240\u4ee5\u8bf4\u81ea\u5df1\u662f\u6700\u5927\u7684\u53d7\u76ca\u8005\uff0c\u662f\u56e0\u4e3a\u6211\u8fd8\u672a\u53c2\u52a0\u5de5\u4f5c\uff0c\u8fd8\u80fd\u6536\u538b\u5c81\u94b1\uff0c\u5e76\u4e14\u8fd9\u4e00\u6b21\uff0c\u538b\u5c81\u94b1\u662f\u771f\u6b63\u5c5e\u4e8e\u6211\u7684\u3002\u5728\u4e0a\u5927\u5b66\u4e4b\u524d\uff0c\u7236\u6bcd\u90fd\u4f1a\u6536\u8d70\u538b\u5c81\u94b1\uff0c\u4ee5\u53d1\u7ed9\u5176\u4ed6\u665a\u8f88\uff0c\u800c\u6211\u57fa\u672c\u4e0a\u53ea\u80fd\u62ff\u4e2a\u96f6\u5934\u5f53\u4f5c\u96f6\u82b1\u94b1\u3002</p> <p>\u8fd9\u6b21\u805a\u9910\uff0c\u6709\u51e0\u4ef6\u4e8b\u503c\u5f97\u4e00\u63d0\u3002</p> <p>\u4e00\u662f\u5916\u516c\u5916\u5a46\u4e8c\u4e94\u5e74\u8eab\u4f53\u72b6\u51b5\u6025\u8f6c\u76f4\u4e0b\uff0c\u53c8\u56e0\u4e3a\u4e00\u4e9b\u610f\u5916\uff0c\u5916\u5a46\u4ecd\u5728\u4f4f\u9662\uff0c\u5916\u516c\u672f\u540e\u60c5\u51b5\u4e5f\u5927\u4e0d\u5982\u524d\uff0c\u4e09\u4f4d\u957f\u8f88\u4e3a\u7167\u987e\u8001\u4eba\u5fd9\u788c\u4e86\u4e00\u5e74\uff0c\u76ee\u524d\u60c5\u51b5\u76f8\u5bf9\u7a33\u5b9a\uff0c\u611f\u6168\u8fd9\u4e00\u5e74\u8fc7\u7684\u4e0d\u5bb9\u6613\u3002</p> <p>\u4e8c\u662f\u6bd4\u6211\u5927\u516d\u5c81\u7684\u90a3\u4f4d\u54e5\u54e5\uff08\u6682\u65f6\u8bb0\u4e3aP\uff09\u6b63\u5f0f\u53c2\u52a0\u5de5\u4f5c\u7b2c\u4e00\u5e74\uff0c\u540c\u65f6\u53c8\u9762\u4e34\u7ed3\u5a5a\u95ee\u9898\uff0c\u611f\u89c9\u88ab\u957f\u8f88\u72e0\u72e0\u538b\u529b\u4e86\u3002P\u7684\u5973\u670b\u53cb\u6bd4P\u5c0f\u4e24\u4e09\u5c81\uff0c\u5b89\u5fbd\u4eba\uff0c\u5bb6\u4e2d\u56db\u4e2a\u5b69\u5b50\uff0c\u5979\u6392\u7b2c\u4e8c\uff0c\u5bb6\u5ead\u7ecf\u6d4e\u60c5\u51b5\u5deeP\u7684\u5bb6\u5ead\u4e0d\u5c11\u3002\u8205\u8205\u63d0\u53ca\u51e0\u4ef6\u548cP\u5973\u670b\u53cb\u76f8\u5173\u7684\u4e8b\u60c5\uff0c\u7efc\u5408\u8868\u8fbe\u4e86\u5bf9\u5979\u7684\u4e0d\u6ee1\u610f\uff0c\u4f46\u611f\u89c9\u5173\u952e\u8fd8\u662f\u5728\u7ecf\u6d4e\u6761\u4ef6\u4e0a\u3002\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u201c\u6700\u7ec8\u51b3\u5b9a\u6743\u5728\u4f60\u201d\u8fd9\u53e5\u8bdd\u597d\u50cf\u6ca1\u6709\u4ec0\u4e48\u5206\u91cf\u4e86\u3002\u4e8b\u5b9e\u4e0a\uff0c\u8205\u8205\u975e\u5e38\u5389\u5bb3\uff0c\u5728\u627e\u5de5\u4f5c\u7684\u65f6\u5019\u7ed9\u4e86P\u83ab\u5927\u7684\u5e2e\u52a9\uff0c\u4ed6\u7684\u610f\u89c1\u60f3\u5fc5\u5bf9P\u5f71\u54cd\u6bd4\u8f83\u5927\uff0cP\u53ef\u4ee5\u8bf4\u662f\u4e24\u5934\u4e3a\u96be\u4e86\u3002</p> <p>\u4e09\u662f\u9910\u684c\u4e0a\u51fa\u73b0\u4e86\u8305\u53f0\u3002\u51e0\u4f4d\u957f\u8f88\u805a\u9910\u559d\u70b9\u767d\u9152\u4e5f\u633a\u5e73\u5e38\uff0c\u4e0d\u77e5\u9053\u662f\u56e0\u4e3a\u6211\u5bf9\u9152\u53d8\u654f\u611f\u4e86\uff0c\u8fd8\u662f\u4eca\u5e74\u786e\u5b9e\u4e0d\u4e00\u6837\uff0c\u8fd9\u4f3c\u4e4e\u662f\u6211\u5728\u5bb6\u5ead\u805a\u9910\u4e0a\u89c1\u5230\u8fc7\u6700\u8d35\u7684\u9152\u4e86\u3002\u4e0e\u5f80\u5e74\u4e0d\u4e00\u6837\u7684\u662f\uff0c\u4e09\u4f4d\u665a\u8f88\u90fd\u88ab\u8981\u6c42\u559d\u9152\u4e86\u3002\u6211\u867d\u7136\u4e0d\u662f\u7b2c\u4e00\u6b21\u559d\u767d\u9152\uff0c\u4f46\u4ee5\u5f80\u5927\u591a\u53ea\u662f\u5c1d\u5c1d\uff0c\u6ca1\u60f3\u5230\u8fd9\u6b21\u628a\u51e0\u4f4d\u957f\u8f88\u90fd\u656c\u4e86\u4e00\u904d\u3002\u8bf4\u5b9e\u8bdd\uff0c\u611f\u89c9\u8305\u53f0\u4e0d\u597d\u559d\uff0c\u7ec6\u54c1\u4e0d\u5982\u4e00\u53e3\u95f7\u3002\u4e0d\u8fc7\u6536\u4e86\u7ea2\u5305\uff0c\u656c\u4e00\u4e0b\u51e0\u4f4d\u957f\u8f88\u4e5f\u662f\u5e94\u8be5\u3002\u5927\u81f4\u4e00\u7b97\uff0c\u81f3\u5c11\u559d\u4e86\u6709\u4e03\u516b\u676f\uff0c\u6ca1\u4ec0\u4e48\u611f\u89c9\u3002</p> <p>\u7b2c\u4e00\u6b21\u611f\u89c9\u5230\u81ea\u5df1\u53c2\u52a0\u5bb6\u5ead\u805a\u9910\u7684\u6027\u8d28\u6709\u4e86\u4e00\u4e9b\u5fae\u5999\u7684\u53d8\u5316\uff0c\u5e78\u597d\u81ea\u5df1\u8fd8\u5728\u8bfb\u4e66\uff0c\u8be5\u5e86\u5e78\u8fd8\u662f\u7126\u8651\uff1f\u6211\u4e5f\u4e0d\u77e5\u9053\u3002</p> <p>\u4ec5\u4f5c\u5206\u4eab\u3002</p>"},{"location":"writings/20260223/","title":"20260223","text":"<p>\u56e0\u4e3a\u6bd4\u8d5b\u96c6\u8bad\uff0c2\u67089\u65e5\u624d\u56de\u5bb6\uff0c2\u670824\u65e5\u5c31\u8981\u8fd4\u6821\uff0c\u5bd2\u5047\u5927\u6982\u5c31\u4e24\u5468\u3002</p> <p>\u5927\u81f4\u56de\u987e\u4e00\u4e0b\uff0c\u57fa\u672c\u90fd\u662f\u5728\u5a31\u4e50\u3002\u5171\u8ba1\u6413\u4e86\u516d\u573a\u9ebb\u5c06\uff0c\u6253\u4e86\u4e00\u573a\u7bee\u7403\u548c\u4e00\u573a\u7fbd\u6bdb\u7403\uff0c\u770b\u4e86\u51e0\u90e8\u52a8\u6f2b\uff08\u300a\u5bc4\u751f\u517d\u300b\u3001\u300a\u8fdb\u51fb\u7684\u5de8\u4eba\u300b\u7b49\uff09\u548c\u4e00\u90e8\u7535\u5f71\uff0c\u548cD\u6253\u4e86\u5f88\u4e45\u7684\u6e38\u620f\uff0c\u5305\u62ecCS\u3001PUBG\u3001pvz\u3001Terraria\u4ee5\u53ca\u5404\u79cd\u68cb\u7c7b\uff0c\u81ea\u5df1\u8fd8\u73a9\u4e862077\u3001\u51b0\u6c7d\u65f6\u4ee3\u3001\u6740\u622e\u5c16\u5854\u7b49\u7b49\u3002</p> <p>\u8fd8\u597d\u5bd2\u5047\u524d\u6ca1\u7ed9\u81ea\u5df1\u8bbe\u7f6e\u4ec0\u4e48\u8ba1\u5212\uff0c\u4ec5\u6709\u7684\u5b89\u6392\u5c31\u662f\u5199\u5b8c\u5b66\u671f\u603b\u7ed3\u548c\u8bfe\u7a0b\u7684\u5206\u4eab\uff0c\u4ee5\u53ca\u642d\u597d\u4e2a\u4eba\u7684\u7f51\u7ad9\uff0c\u4e0d\u8fc7\u540e\u8005\u8c8c\u4f3c\u4e5f\u6ca1\u6709\u4ec0\u4e48\u8fdb\u5ea6\u3002</p> <p>\u611f\u89c9\u96c6\u8bad\u5f3a\u5ea6\u5b9e\u5728\u5927\uff0c\u5bfc\u81f4\u56de\u5bb6\u4e4b\u540e\u6ca1\u6709\u4e00\u70b9\u5de5\u4f5c\u7684\u60f3\u6cd5\uff0c\u5199\u5b8c\u5de5\u4f5c\u8bb0\u5f55\u4e4b\u540e\u5c31\u518d\u4e5f\u6ca1\u6709\u6253\u5f00\u8fc7\u5de5\u4f5c\u73af\u5883\u3002\u5047\u671f\u5f00\u59cb\u770b\u300a\u4ee5\u65e5\u4e3a\u9274\u300b\uff0c\u4e0d\u8fc7\u6ca1\u770b\u51e0\u5341\u9875\uff0c\u5f00\u5b66\u4e4b\u540e\u5e0c\u671b\u6709\u65f6\u95f4\u770b\u770b\u5b8c\u3002</p> <p>\u5bd2\u5047\u65f6\u95f4\u4e0d\u957f\uff0c\u52a0\u4e4b\u524d\u540e\u90fd\u6709\u5de5\u4f5c\uff0c\u5bd2\u5047\u671f\u95f4\u653e\u677e\u723d\u73a9\u53cd\u800c\u6ca1\u4ec0\u4e48\u5fc3\u7406\u8d1f\u62c5\uff0c\u4e0d\u8fc7\u4f5c\u606f\u5b9e\u5728\u662f\u9634\u95f4\uff0c\u5f00\u5b66\u5f97\u5c3d\u5feb\u8c03\u6574\u4e86\u3002</p>"}]}